# Local run of the wiki sync, from a consumer repo checkout:
#   cp runtime/wiki/.env.example .env; edit; source .env
#   bash /path/to/gitlab-ci-templates/runtime/wiki/wiki-deploy.sh docs /tmp/wiki-clone
# Never commit a token.
GITLAB_HOST=gitlab.example
GITLAB_PROJECT_PATH=group/project
CI_DEFAULT_BRANCH=main
# group (or project) access token, scope write_repository; role Maintainer if the branch is protected
WIKI_TOKEN=
# optional
# DRY_RUN=1
# MKDOCS_CONFIG=mkdocs.yml
