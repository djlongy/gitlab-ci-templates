# Local run of the wiki sync, from a consumer repo checkout:
#   cp scripts/wiki/.env.example ~/.wiki-sync.env; chmod 600 it; edit; source it
#   Keep it outside any checkout so a token cannot be committed.
#   bash /path/to/gitlab-ci-templates/scripts/wiki/wiki-deploy.sh docs /tmp/wiki-clone
# Never commit a token.
GITLAB_HOST=gitlab.example.com
GITLAB_PROJECT_PATH=group/project
CI_DEFAULT_BRANCH=main
# group (or project) access token, scope write_repository; role Maintainer if the branch is protected
WIKI_TOKEN=
# optional
# DRY_RUN=1
# MKDOCS_CONFIG=mkdocs.yml
