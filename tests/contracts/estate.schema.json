{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitlab.example.com/platform/gitlab-ci-templates/.ci/estate.schema.json",
  "title": "Estate profile",
  "description": "Schema for .ci/estate.yml, per docs/gitlab-ci-agent-standard.md section 4. Any field the standard requires may instead hold the literal string 'unresolved', which asserts that the fact was not verified.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gitlab",
    "shared_ci",
    "runners",
    "images",
    "registries",
    "auth",
    "terraform",
    "kubernetes",
    "security",
    "retention",
    "environments"
  ],
  "$defs": {
    "unresolved": {
      "const": "unresolved"
    },
    "flag": {
      "anyOf": [{"type": "boolean"}, {"$ref": "#/$defs/unresolved"}]
    },
    "text": {
      "anyOf": [{"type": "string", "minLength": 1}, {"$ref": "#/$defs/unresolved"}]
    },
    "date": {
      "anyOf": [
        {"type": "string", "pattern": "^[0-9]{4}/[0-9]{2}/[0-9]{2}$"},
        {"$ref": "#/$defs/unresolved"}
      ]
    },
    "objectOrUnresolved": {
      "anyOf": [{"type": "object"}, {"$ref": "#/$defs/unresolved"}]
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "gitlab": {
      "type": "object",
      "required": ["host", "version", "tier", "verified_at", "capabilities"],
      "properties": {
        "host": {"type": "string", "pattern": "^[a-z0-9.-]+(:[0-9]+)?$"},
        "version": {"$ref": "#/$defs/text"},
        "tier": {"$ref": "#/$defs/text"},
        "verified_at": {"$ref": "#/$defs/date"},
        "capabilities": {
          "type": "object",
          "required": [
            "components",
            "inputs",
            "native_sarif",
            "policy_enforcement",
            "deployment_approvals"
          ],
          "additionalProperties": {"$ref": "#/$defs/flag"}
        }
      }
    },
    "shared_ci": {
      "type": "object",
      "required": ["project", "approved_ref"],
      "properties": {
        "project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$"},
        "project_id": {"type": "integer", "minimum": 1},
        "verified_at": {"$ref": "#/$defs/date"},
        "approved_ref": {
          "description": "A full commit SHA or a protected immutable release tag. A moving ref such as main is not an approved ref (section 14.2), so it must be recorded as unresolved until a release exists.",
          "anyOf": [
            {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+"},
            {"$ref": "#/$defs/unresolved"}
          ]
        }
      }
    },
    "runners": {
      "anyOf": [
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "tags",
              "executor",
              "privileged",
              "architecture",
              "trust_level",
              "network_access"
            ],
            "properties": {
              "tags": {
                "anyOf": [
                  {"type": "array", "items": {"type": "string"}},
                  {"$ref": "#/$defs/unresolved"}
                ]
              },
              "executor": {"$ref": "#/$defs/text"},
              "privileged": {"$ref": "#/$defs/flag"},
              "architecture": {"$ref": "#/$defs/text"},
              "trust_level": {"$ref": "#/$defs/text"},
              "network_access": {"$ref": "#/$defs/text"}
            }
          }
        },
        {"$ref": "#/$defs/unresolved"}
      ]
    },
    "images": {"$ref": "#/$defs/objectOrUnresolved"},
    "registries": {
      "anyOf": [
        {
          "type": "object",
          "required": ["candidate", "release"],
          "additionalProperties": {
            "type": "object",
            "required": ["endpoint", "project"],
            "properties": {
              "endpoint": {"type": "string", "minLength": 1},
              "project": {"type": "string", "minLength": 1}
            }
          }
        },
        {"$ref": "#/$defs/unresolved"}
      ]
    },
    "auth": {"$ref": "#/$defs/objectOrUnresolved"},
    "terraform": {
      "type": "object",
      "required": ["engine", "backend"],
      "properties": {
        "engine": {"enum": ["terraform", "opentofu", "unresolved"]},
        "backend": {"$ref": "#/$defs/objectOrUnresolved"}
      }
    },
    "kubernetes": {
      "type": "object",
      "required": ["deployment_mode"],
      "properties": {
        "deployment_mode": {"enum": ["gitops", "direct", "unresolved"]}
      }
    },
    "security": {
      "type": "object",
      "required": ["report_mode", "defaults"],
      "properties": {
        "report_mode": {
          "enum": ["gitlab-native", "sarif", "artifact-only", "unresolved"]
        },
        "defaults": {"$ref": "#/$defs/objectOrUnresolved"}
      }
    },
    "retention": {"$ref": "#/$defs/objectOrUnresolved"},
    "environments": {
      "anyOf": [
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "protected", "approvers"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
              "protected": {"$ref": "#/$defs/flag"},
              "approvers": {
                "anyOf": [
                  {"type": "array", "items": {"type": "string"}},
                  {"$ref": "#/$defs/unresolved"}
                ]
              }
            }
          }
        },
        {"$ref": "#/$defs/unresolved"}
      ]
    }
  }
}
