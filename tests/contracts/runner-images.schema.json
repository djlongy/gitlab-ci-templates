{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitlab.example.com/platform/gitlab-ci-templates/runner-images.schema.json",
  "title": "Runner image digest catalogue",
  "description": "images/runner-images.yml: what a runner image resolves to, by digest. D10 of the runner-images design.",
  "type": "object",
  "required": ["schema_version", "images"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "images": {
      "type": "array",
      "items": {"$ref": "#/$defs/image"}
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "required": ["name", "repository", "digest", "tag", "built_from", "verified_at"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "repository": {
          "type": "string",
          "description": "Fully qualified, with no tag and no digest attached.",
          "pattern": "^[a-z0-9][a-z0-9.-]*(:[0-9]+)?(/[a-z0-9][a-z0-9._-]*)+$"
        },
        "digest": {
          "type": "string",
          "description": "The manifest digest. A tag is not an identity.",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "tag": {
          "type": "string",
          "description": "Recorded so a human can find the build; nothing resolves it.",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]{0,126}$"
        },
        "built_from": {
          "type": "object",
          "required": ["project", "pipeline_id", "commit"],
          "additionalProperties": false,
          "properties": {
            "project": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._/-]*$"
            },
            "pipeline_id": {
              "type": "integer",
              "minimum": 1
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        },
        "verified_at": {
          "type": "string",
          "description": "yyyy/mm/dd, the day the digest was checked against the registry.",
          "pattern": "^[0-9]{4}/[0-9]{2}/[0-9]{2}$"
        }
      }
    }
  }
}
