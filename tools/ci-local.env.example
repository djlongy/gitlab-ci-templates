# Variables for tools/ci-local.py --env-file. Copy, fill in, keep out of git.
#
#     cp tools/ci-local.env.example ~/.config/ci-local.env
#     python3 tools/ci-local.py --template security-image-trivy --input instance=demo \
#       --job demo:security-image-trivy --checkout ~/src/myapp \
#       --env-file ~/.config/ci-local.env
#
# This file is the highest-precedence source: it overrides the job's own
# `variables:` and the predefined stand-ins in tools/ci-local.py. Every line is
# KEY=VALUE; `#` comments and blank lines are ignored. A value may not contain a
# newline, because docker's --env-file cannot carry one.
#
# It holds real credentials once filled in. Put it outside the checkout, chmod
# 600 it, and never commit it: `.ci-local.env` is gitignored, this example is
# the only file of its kind that belongs in the repository.

# --- Variables that decide which branch of a script runs ---------------------
# Set these explicitly. tools/ci-local.py never evaluates `rules:`, so it runs
# the job you name whatever these say; what they change is the path the SCRIPT
# takes. gitlab-ci-local does evaluate rules, and derives these from your local
# git checkout, so a rule keyed on one of them is decided by whichever branch
# you happen to be on unless you pin it here.

# Which pipeline this pretends to be. The default is `push`. Nearly every
# component's run-rules distinguish this from `merge_request_event`, and a
# script that reports differently per source takes the wrong path without it.
# CI_PIPELINE_SOURCE=merge_request_event

# Set as a group whenever CI_PIPELINE_SOURCE is merge_request_event. A runner
# sets all three on an MR pipeline and none of them otherwise; supplying one
# alone produces a state no real pipeline ever has.
# CI_MERGE_REQUEST_IID=1
# CI_MERGE_REQUEST_SOURCE_BRANCH_NAME=feature/my-branch
# CI_MERGE_REQUEST_TARGET_BRANCH_NAME=main

# Protected-branch status. Defaults to false, which is the safe default: a
# protected variable is absent from an unprotected branch's pipeline, and
# claiming `true` here tells you nothing about whether the secret would arrive.
# The `release` job is gated on this being "true" AND a version tag.
# CI_COMMIT_REF_PROTECTED=true

# The branch name. gitlab-ci-local reads this off your checkout; ci-local.py
# defaults it to `main`, which also makes it equal CI_DEFAULT_BRANCH and so
# satisfies the default-branch half of a component's run-rules.
# CI_COMMIT_BRANCH=feature/my-branch

# A tag-gated path. Unset by default, because that is what a runner does on a
# branch pipeline, and `${CI_COMMIT_TAG:-}` must see unset rather than empty.
# CI_COMMIT_TAG=1.2.3

# This repository's own project id, if a script calls back into the API.
# CI_PROJECT_ID=1

# --- Registry credentials ---------------------------------------------------
# Read them out of whatever secret manager holds them rather than typing them;
# never paste one into a shell where it lands in the transcript.
# CI_TPL_REGISTRY=registry.example.com
# CI_TPL_REGISTRY_USER=robot$ci-local
# CI_TPL_REGISTRY_PASSWORD=

# --- Tokens a job reads -----------------------------------------------------
# CI_JOB_TOKEN has no local equivalent: it is minted per job by the server. A
# job that genuinely needs it cannot be proven here, only run on a real
# pipeline. A personal token is a different credential with different scopes,
# so substituting one tests a path the job will not take.
# CI_JOB_TOKEN=
# WIKI_TOKEN=
# SONAR_TOKEN=
# DTRACK_API_KEY=

# --- Egress -----------------------------------------------------------------
# CI_TPL_EGRESS_PROXY=http://proxy.example.com:3128
